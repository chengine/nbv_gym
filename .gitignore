nerfstudio/
outputs/
scripts/
tests/
pyproject.toml
requirements.txt
*.egg-info/
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/

# --- Project docs not needed by the site ---
CLAUDE.md

# --- Unused viser viewer client (no longer embedded in the site) ---
viser-client/

# --- Unused static assets ---
static/pdfs/
static/videos/
static/images/
